# 数据库
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mailpilot

# 安全
SECRET_KEY=your-secret-key-here

# 服务配置
HOST=0.0.0.0
PORT=8000

# Worker 配置
WORKER_CONCURRENCY=5        # 并发发送任务数
WORKER_POLL_INTERVAL=1      # 无任务时轮询间隔（秒）

# 管理员（首次启动自动创建）
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme

# Session
SESSION_SECRET_KEY=          # 可选，不填则用 SECRET_KEY
SESSION_MAX_AGE=86400        # session 有效期（秒），默认 24 小时
